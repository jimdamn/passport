{
  "name": "krowdkraft-passport",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev ./ui/dist --d1=DB --kv=PASSPORT_CONFIG --port=8788",
    "dev:ui": "cd ui && npm run dev",
    "build": "cd ui && npm run build",
    "deploy": "npm run build && wrangler pages deploy ./ui/dist",
    "db:create": "wrangler d1 create krowdkraft-passport",
    "db:migrate": "wrangler d1 execute krowdkraft-passport --file=./schema.sql --local",
    "db:seed": "wrangler d1 execute krowdkraft-passport --file=./seed.sql --local",
    "db:reset": "wrangler d1 execute krowdkraft-passport --file=./schema.sql --local && wrangler d1 execute krowdkraft-passport --file=./seed.sql --local",
    "db:migrate:remote": "wrangler d1 execute krowdkraft-passport --file=./schema.sql --remote",
    "db:seed:remote": "wrangler d1 execute krowdkraft-passport --file=./seed.sql --remote",
    "db:reset:remote": "wrangler d1 execute krowdkraft-passport --file=./schema.sql --remote && wrangler d1 execute krowdkraft-passport --file=./seed.sql --remote",
    "test": "vitest run && vitest run -c vitest.workers.config.mts",
    "check:economy": "node scripts/check-economy-registry.mjs"
  },
  "dependencies": {
    "hono": "^4.12.27",
    "jose": "^5.6.3",
    "nanoid": "^5.0.7",
    "qr-svg": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260808.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
